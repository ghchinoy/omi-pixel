# Google Cloud Project Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GCP_REGION=us-central1
SERVICE_NAME=omi-pixel-service
SERVICE_ACCOUNT_NAME=sa-omi-pixel

# Firestore Database Name
# Best practice: use a dedicated named database (e.g. omi-pixel) rather than (default).
FIRESTORE_DATABASE=omi-pixel

# Google Cloud Storage Audio Bucket
GCS_BUCKET=your-gcp-project-id-omi-pixel-audio

# Firebase Authentication & Authorization Allowlist
# Set AUTH_DISABLED=true only for local offline development without Firebase tokens.
AUTH_DISABLED=false

# Firebase Client Configuration (for Web Review Dashboard & Android App Google Sign-In)
# Obtain from Firebase Console > Project Settings > Your apps, or from app/lib/firebase_options.dart after running `make configure-firebase`.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=

# Vertex AI Model Configuration (ADC / Service Account Authenticated)
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-transcribe
GEMINI_LIVE_MODEL=gemini-3.5-transcribe-live
TITLE_MODEL=gemini-3.5-flash-lite
SUMMARY_MODEL=gemini-3.8-flash

# Service Port (for local execution)
PORT=8080
