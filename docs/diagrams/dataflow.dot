digraph OmiPixelDataFlow {
    graph [
        rankdir=TB,
        bgcolor="#0b0f17",
        fontname="Helvetica,Arial,sans-serif",
        fontsize=12,
        pad="0.5",
        nodesep="0.5",
        ranksep="0.6"
    ];

    node [
        shape=box,
        style="filled,rounded",
        fontname="Helvetica,Arial,sans-serif",
        fontsize=11,
        color="#334155",
        fontcolor="#f1f5f9",
        penwidth=1.5,
        margin="0.2,0.12"
    ];

    edge [
        fontname="Helvetica,Arial,sans-serif",
        fontsize=9,
        color="#8496ae",
        fontcolor="#93c5fd",
        penwidth=1.2,
        arrowsize=0.8
    ];

    // Capture & Decode
    step_mic [label="1. Omi Wearable Capture\n(16kHz Mono Audio • ForegroundService Active)", fillcolor="#1a2336", color="#60a5fa"];
    step_ble [label="2. BLE GATT Stream\n(Opus Codec 20 / 21 + 3-Byte Header • Connection Monitored)", fillcolor="#1a2336"];
    step_decode [label="3. Flutter Audio Pipeline\n(Header Strip + Native libopus Decode -> 16kHz PCM)", fillcolor="#1e3a8a", color="#93c5fd"];

    // Pass 1: Live
    step_live_ws [label="Pass 1: Live Proxy (/api/live, Authorization: Bearer)\n(Gemini 3.5 Transcribe Live • Verbatim or Smart Self-Corrections)", fillcolor="#172554", color="#93c5fd"];
    step_live_ui [label="Live Screen UI\n(Real-Time Transcript + Audio Health Pill + Minimize/PopScope)", fillcolor="#1a2336", color="#60a5fa"];

    // Pass 2 & 3: Durable Disk + Background Diarization
    step_disk_wav [label="Pass 2: Disk PCM Stream -> Durable WAV\n(RecordingFileStore + Pending Upload Queue • Instant Return to Home)", fillcolor="#064e3b", color="#34d399"];
    step_upload [label="Background HTTP Upload (401 Refresh Retry)\n(POST /api/sessions/{id}/audio?summary=true&summary_model=gemini-4-hydrogen)", fillcolor="#232f46"];
    step_gcs [label="GCS Audio Persistence\n(gs://...-omi-pixel-audio/sessions/{id}/audio.wav)", fillcolor="#064e3b", color="#34d399"];
    step_diarize [label="Pass 2: Speaker Diarization\n(Gemini 3.5 Transcribe • Word Timestamps)", fillcolor="#1e2b58", color="#93c5fd"];
    step_synthesis [label="Pass 3: Title & Synthesis\n(Gemini 3.5 Flash-Lite Title + Gemini 4 Hydrogen / 3.8 Flash Summary)", fillcolor="#2e1065", color="#ddd6fe"];
    step_store [label="Firestore Persistence (BulkWriter)\n(Session Metadata, Title, Summary & Speaker Turns)", fillcolor="#064e3b", color="#34d399"];
    step_review [label="Lustrous Review & Playback Surfaces\n(Pixel App Light/Dark + @ghchinoy/lustrous-lit Web SPA • Auto-Polling & Delete)", fillcolor="#0b0f17", color="#5eead4"];

    // Flow
    step_mic -> step_ble;
    step_ble -> step_decode;

    // Pass 1
    step_decode -> step_live_ws [label="~100ms PCM Chunks"];
    step_live_ws -> step_live_ui [label="Live Transcript Events"];

    // Pass 2 & 3
    step_decode -> step_disk_wav [label="Crash-Safe Disk Stream"];
    step_disk_wav -> step_upload [label="Detached Background Upload"];
    step_upload -> step_gcs [label="Store 16kHz WAV"];
    step_gcs -> step_diarize [label="fileUri: gs://..."];
    step_diarize -> step_synthesis [label="Speaker Turns"];
    step_synthesis -> step_store [label="Completed Session"];
    step_store -> step_review [label="Synced JSON + Tap-to-Seek WAV"];
}
