digraph OmiPixelArchitecture {
    graph [
        rankdir=LR,
        bgcolor="#0b0f17",
        fontname="Helvetica,Arial,sans-serif",
        fontsize=12,
        pad="0.5",
        nodesep="0.55",
        ranksep="0.8",
        splines=polyline
    ];

    node [
        shape=box,
        style="filled,rounded",
        fontname="Helvetica,Arial,sans-serif",
        fontsize=11,
        color="#334155",
        fontcolor="#f1f5f9",
        penwidth=1.5,
        margin="0.2,0.14"
    ];

    edge [
        fontname="Helvetica,Arial,sans-serif",
        fontsize=9,
        color="#8496ae",
        fontcolor="#93c5fd",
        penwidth=1.2,
        arrowsize=0.8
    ];

    subgraph cluster_hardware {
        label="Wearable Hardware";
        fontcolor="#94a3b8";
        color="#334155";
        style="dashed,rounded";
        omi_dev [label="Omi Wearable\n(DevKit / CV1)", fillcolor="#1a2336", color="#60a5fa"];
    }

    subgraph cluster_phone {
        label="Pixel Companion App (Flutter + Lustrous Theme)";
        fontcolor="#94a3b8";
        color="#334155";
        style="rounded";
        bgcolor="#111827";

        ble_layer [label="BLE Client\n(omi_device + Auto-Reconnect\nButton & Haptic GATT)", fillcolor="#1a2336"];
        decoder [label="Opus Decoder\n(16kHz PCM / Codec 20 & 21)", fillcolor="#1a2336"];
        fgs [label="Android ForegroundService\n(connectedDevice + WakeLock)", fillcolor="#115e59", color="#5eead4"];
        auth_service [label="Firebase Auth\n(Google Sign-In + 401 Refresh)", fillcolor="#78350f", color="#fbbf24"];
        disk_queue [label="RecordingFileStore\n(Disk PCM/WAV + Retry Queue)", fillcolor="#064e3b", color="#34d399"];
        live_client [label="Live WS Client\n(Bearer Header / Verbatim & Smart)", fillcolor="#1e3a8a", color="#93c5fd"];
        ui_live [label="Lustrous Flutter UI\n(Light/Auto/Dark + Background UX)", fillcolor="#0b0f17", color="#60a5fa"];

        ble_layer -> decoder [label="Opus Packets"];
        decoder -> disk_queue [label="Stream PCM to Disk"];
        decoder -> live_client [label="100ms PCM Chunks"];
        live_client -> ui_live [label="Live Text"];
        fgs -> disk_queue [style=dotted, label="Keeps Alive"];
    }

    subgraph cluster_cloud {
        label="Cloud Run Backend Service (Go 1.26.10 / Alpine 3.24)";
        fontcolor="#94a3b8";
        color="#334155";
        style="rounded";
        bgcolor="#111827";

        authmw [label="Firebase Auth &\nAllowlist Middleware\n(Header Bearer Only)", fillcolor="#78350f", color="#fbbf24"];
        live_proxy [label="Live WS Proxy\n(Bidi Relay + 32MB Orphan Recovery)", fillcolor="#1e3a8a", color="#93c5fd"];
        http_api [label="HTTP API Router\n(/sessions, /audio, /reprocess, DELETE)", fillcolor="#232f46"];
        gcs_store [label="GCS Audio Store\n(gs://...-omi-pixel-audio)", fillcolor="#064e3b", color="#34d399"];
        gemini_engine [label="Vertex AI Client\n(3.5 Transcribe / 3.5 Flash-Lite\n4 Hydrogen / 3.8 Flash)", fillcolor="#2e1065", color="#ddd6fe"];
        store [label="Firestore DB\n(named: omi-pixel / BulkWriter)", fillcolor="#064e3b", color="#34d399"];
        web_ui [label="Lustrous Web Review SPA\n(@ghchinoy/lustrous-lit@0.2.0)", fillcolor="#0b0f17", color="#60a5fa"];

        authmw -> live_proxy;
        authmw -> http_api;
        live_proxy -> gcs_store [style=dashed, label="Orphan Fallback WAV"];
        http_api -> gcs_store [label="16kHz WAV"];
        http_api -> gemini_engine [label="Diarize & Summarize"];
        gemini_engine -> store [label="Segments & Metadata"];
        store -> web_ui [label="Auto-Polling Detail"];
    }

    subgraph cluster_vertex {
        label="Google Cloud Vertex AI (global / ADC)";
        fontcolor="#94a3b8";
        color="#334155";
        style="dashed,rounded";
        vertex_live [label="Gemini 3.5 Transcribe Live\n(Verbatim & Smart Self-Corrections)", fillcolor="#172554", color="#93c5fd"];
        vertex_batch [label="Gemini 3.5 Transcribe\n(Diarization + Word Timestamps)", fillcolor="#1e2b58", color="#93c5fd"];
        vertex_title [label="Gemini 3.5 Flash-Lite\n(Title Generation)", fillcolor="#2e1065", color="#ddd6fe"];
        vertex_summary [label="Gemini 4 Hydrogen (Default)\n/ Gemini 3.8 Flash (Summary)", fillcolor="#2e1065", color="#ddd6fe"];
    }

    omi_dev -> ble_layer [label="BLE GATT\n(Audio + Button + Haptic)", color="#60a5fa"];
    live_client -> live_proxy [label="WSS /api/live\n(Authorization: Bearer)", color="#60a5fa"];
    live_proxy -> vertex_live [label="Bidi WS\n(ADC Token)", color="#60a5fa"];
    vertex_live -> live_proxy [label="Live Tokens", color="#60a5fa"];
    live_proxy -> live_client [label="Event JSON", color="#60a5fa"];

    disk_queue -> http_api [label="Background POST /audio\n(Bearer + summary_model)", color="#34d399"];
    gemini_engine -> vertex_batch [label="fileUri: gs://...", color="#ddd6fe"];
    gemini_engine -> vertex_title [label="Transcript -> Title", color="#ddd6fe"];
    gemini_engine -> vertex_summary [label="Transcript -> Summary\n(thinkingLevel: LOW)", color="#ddd6fe"];
}
